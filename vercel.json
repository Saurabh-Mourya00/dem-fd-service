{
  "version": 2,
  "builds": [
    {
      "src": "build.sh",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "django_pro/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "django_pro/wsgi.py" }
  ]
}
